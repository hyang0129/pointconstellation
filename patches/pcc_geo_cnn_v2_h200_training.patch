+# CUDA 10 predates Hopper and its batched GEMM fails for TensorFlow
+# Compression's tiny entropy-bottleneck matrices. Keep only those linalg
+# matrix operations and their gradients on CPU; 3D convolutions and the
+# remaining optimization graph stay on GPU.
+@tf.RegisterGradient('CpuBatchMatMulV2')
+def _cpu_batch_matmul_grad(op, grad):
+    with tf.device('/cpu:0'):
+        return math_grad._BatchMatMulV2(op, grad)
+
+_gpu_incompatible_matmul = tf.linalg.matmul
+def _cpu_entropy_matmul(*args, **kwargs):
+    graph = tf.get_default_graph()
+    with graph.gradient_override_map({'BatchMatMulV2': 'CpuBatchMatMulV2'}):
+        with tf.device('/cpu:0'):
+            return _gpu_incompatible_matmul(*args, **kwargs)
+tf.linalg.matmul = _cpu_entropy_matmul
+
 
 def train():
     p_min, p_max, dense_tensor_shape = pc_io.get_shape_data(args.resolution, args.data_format)
